 export function createWorld(seed=41,overrides={}){const s={version:VERSION,seed:seed>>>0,tick:0,config:{...DEFAULTS,...overrides},bridge:false,patches:[{id:'a',name:'Berry grove',x:10,y:9,stock:120,capacity:120,regen:overrides.regenA??DEFAULTS.regenA,gift:false},{id:'b',name:'Root garden',x:27,y:15,stock:120,capacity:120,regen:overrides.regenB??DEFAULTS.regenB,gift:false}],creatures:[],ledger:{initial:240,regenerated:0,gifted:0,consumed:0},events:[],commands:[],digest:0};for(let id=0;id<24;id++)s.creatures.push({id,name:names[id],x:7+Math.floor(noise(seed,0,id)*8),y:8+Math.floor(noise(seed,0,id,1)*9),alive:true,hunger:20,energy:80,starving:0,known:{},skills:{a:0,b:0},visited:{},action:null,decision:null,memories:[],consumed:0,giftConsumed:0,times:{travel:0,gather:0,rest:0,explore:0},death:null});event(s,'The island begins. 24 lives, two food sources.');return s;}
